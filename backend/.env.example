# Local only. Copy to .env and set your own secret before real deployment.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-unique-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# For PostgreSQL production, install requirements-postgres.txt and set DATABASE_URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/agropulse

# Qorako‘l v0.5 sensor protocol: reject more than this many days old (1..365).
AGRO_DEVICE_MAX_AGE_DAYS=30
# Production HTTPS only: set DJANGO_DEBUG=0, strong secret, exact hosts and CORS.
# SECURE_HSTS_SECONDS=3600  # ONLY after HTTPS domain and reverse proxy are verified
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
